    { "id": "skos-orch", "from": "skos", "to": "orch", "label": "delegates by object identity", "variant": "default" },
    { "id": "serve-daemon", "from": "serve", "to": "daemon", "variant": "default" },
    { "id": "daemon-auth", "from": "daemon", "to": "auth", "variant": "default" },
    { "id": "auth-verify", "from": "auth", "to": "verify", "variant": "security" },
