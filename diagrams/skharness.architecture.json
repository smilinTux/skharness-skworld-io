    { "id": "daemon-cc", "from": "daemon", "to": "cc", "variant": "default" },
    { "id": "daemon-store", "from": "daemon", "to": "store", "variant": "default" },
    { "id": "daemon-reg", "from": "daemon", "to": "reg", "variant": "default" },
    { "id": "orch-eng", "from": "orch", "to": "eng", "variant": "default" },
    { "id": "eng-prot", "from": "eng", "to": "prot", "variant": "default" },
    { "id": "eng-ci", "from": "eng", "to": "ci", "variant": "default" },
    { "id": "orch-doctor", "from": "orch", "to": "doctor", "variant": "default" },
    { "id": "eng-cc", "from": "eng", "to": "cc", "variant": "default" },
    { "id": "orch-reg", "from": "orch", "to": "reg", "variant": "default" },
    { "id": "orch-skgw", "from": "orch", "to": "skgw", "label": "work_grade -> bucket id", "variant": "default" },
    { "id": "skgw-eng", "from": "skgw", "to": "eng", "label": "concrete serving member", "variant": "dashed" },
    { "id": "cc-worktree", "from": "cc", "to": "worktree", "label": "allowlist, empty = DENY ALL", "variant": "security" }
  ],
  "cards": [
    { "dot": "amber", "title": "Tailnet only", "items": ["No public route: no :443 vhost, no Cloudflare Tunnel, no Funnel", "serve.resolve_bind() refuses a wildcard bind"] },
    { "dot": "cyan", "title": "Fail-closed gates", "items": ["Missing capauth import falls back to deny-all verification", "Empty SKCODE_DISPATCH_REPOS denies every dispatch", "protected.py fails closed on any manifest load failure"] }
