    { "id": "skos", "type": "external", "label": "skos.autopilot", "sublabel": "shim, delegates to the engine", "pos": [520, 40], "size": [200, 64] },

    { "id": "serve", "type": "backend", "label": "serve.py", "sublabel": "resolve_bind + select_verifier", "pos": [40, 180], "size": [200, 64] },
    { "id": "daemon", "type": "backend", "label": "daemon.py", "sublabel": "FastAPI routes + ROUTE_SCOPES", "pos": [280, 180], "size": [200, 64] },
    { "id": "auth", "type": "backend", "label": "auth.py", "sublabel": "require_bearer, AuthContext scopes", "pos": [520, 180], "size": [200, 64] },
    { "id": "opcli", "type": "backend", "label": "operator_cli.py", "sublabel": "explain / observe / act", "pos": [760, 180], "size": [200, 64] },

    { "id": "verify", "type": "security", "label": "verify_audience_token", "sublabel": "audience = skcode", "pos": [40, 320], "size": [200, 64] },
    { "id": "pdp", "type": "security", "label": "capauth.authz.decide", "sublabel": "PDP, VERIFIED floor", "pos": [280, 320], "size": [200, 64] },

    { "id": "orch", "type": "backend", "label": "orchestrator.py", "sublabel": "phases 0-3, caps, kill switch", "pos": [40, 460], "size": [200, 64] },
    { "id": "eng", "type": "backend", "label": "engineering.py", "sublabel": "worktree + sandbox + twin gate", "pos": [280, 460], "size": [200, 64] },
    { "id": "prot", "type": "backend", "label": "protected.py", "sublabel": "carve-out detector, fail closed", "pos": [520, 460], "size": [200, 64] },
    { "id": "ci", "type": "backend", "label": "ci.py", "sublabel": "external CI verdict", "pos": [40, 600], "size": [200, 64] },
    { "id": "doctor", "type": "backend", "label": "doctor.py", "sublabel": "preflight self-check", "pos": [280, 600], "size": [200, 64] },

    { "id": "cc", "type": "backend", "label": "claude_code.py", "sublabel": "tmux adapter + spawn() guard", "pos": [40, 740], "size": [200, 64] },
    { "id": "store", "type": "database", "label": "session_events.py", "sublabel": "SessionEventStore, append only", "pos": [280, 740], "size": [200, 64] },
    { "id": "reg", "type": "backend", "label": "autocode/sessions.py", "sublabel": "AutocodeSessionRegistry", "pos": [520, 740], "size": [200, 64] },

    { "id": "skgw", "type": "external", "label": "skgateway bucket pool", "sublabel": "per-call model override", "pos": [40, 880], "size": [200, 64] },
    { "id": "worktree", "type": "external", "label": "Per-card worktree + sandbox", "sublabel": "dispatch repo allowlist", "pos": [280, 880], "size": [200, 64] }
  ],
  "boundaries": [
    { "kind": "region", "label": "Callers", "wraps": ["phone", "atlas", "skos"] },
    { "kind": "region", "label": "skcode-hostd (one per host)", "wraps": ["serve", "daemon", "auth", "opcli"] },
    { "kind": "security-group", "label": "capauth (separate repo)", "wraps": ["verify", "pdp"] },
    { "kind": "region", "label": "autocode engine (library)", "wraps": ["orch", "eng", "prot", "ci", "doctor"] },
    { "kind": "region", "label": "Harness / session plane", "wraps": ["cc", "store", "reg"] }
  ],
  "connections": [
